{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter frontend build",
    "start": "pnpm --filter frontend start",
    "architecture-tests": "pnpm exec depcruise domain/src frontend/src",
    "test": "pnpm --filter pt-domain test && pnpm --filter frontend test",
    "tsc": "pnpm exec tsc --build",
    "tsc:watch": "pnpm exec tsc --build --watch",
    "prepare": "husky",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "knip": "knip",
    "qlty:smells": "node scripts/qlty-smells.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "knip": "^6.44.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm oxfmt",
      "pnpm oxlint --fix",
      "node scripts/qlty-smells.mjs --base HEAD"
    ],
    "*.{json,md,css,less,html}": [
      "pnpm oxfmt"
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
